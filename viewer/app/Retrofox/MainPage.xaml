<Page
    x:Class="Retrofox.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource PhoneBackgroundBrush}">

    <Page.Resources>
        <!-- Lowercase menu items, as in the phone's app bar menus -->
        <Style x:Key="MenuItem" TargetType="TextBlock">
            <Setter Property="FontSize" Value="25.33" />
            <Setter Property="FontFamily" Value="{ThemeResource PhoneFontFamilySemiLight}" />
            <Setter Property="Foreground" Value="{ThemeResource PhoneForegroundBrush}" />
            <Setter Property="Padding" Value="20,9,20,10" />
        </Style>
    </Page.Resources>

    <!-- Laid out like Internet Explorer on Windows Phone 8.1: the page fills the screen and the
         address bar sits over its bottom edge (so hiding it never re-lays out the page), with
         refresh/stop inside the address field, then tabs and "..." -->
    <Grid x:Name="Root">

        <!-- The page, drawn by rfxengine -->
        <Grid x:Name="PageArea" Background="White"
              SizeChanged="PageArea_SizeChanged"
              PointerPressed="PageArea_PointerPressed"
              PointerMoved="PageArea_PointerMoved"
              PointerReleased="PageArea_PointerReleased"
              PointerCanceled="PageArea_PointerCanceled"
              PointerCaptureLost="PageArea_PointerCanceled">
            <!-- The page just above and below the screen, drawn ahead by the engine (STRIP), so a
                 pan shows page instead of blank while the next frame is drawn
                 (MainPage.Strips.cs) -->
            <Image x:Name="StripImageA" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top"
                   Visibility="Collapsed">
                <Image.RenderTransform>
                    <TranslateTransform x:Name="StripShiftA" />
                </Image.RenderTransform>
            </Image>
            <Image x:Name="StripImageB" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top"
                   Visibility="Collapsed">
                <Image.RenderTransform>
                    <TranslateTransform x:Name="StripShiftB" />
                </Image.RenderTransform>
            </Image>
            <Image x:Name="PageImage" Stretch="Fill">
                <Image.RenderTransform>
                    <TranslateTransform x:Name="PageShift" />
                </Image.RenderTransform>
            </Image>
            <!-- The page's fixed parts (position: fixed headers and bars), held in place while the
                 page moves under them (FIXED) -->
            <Canvas x:Name="FixedLayer" IsHitTestVisible="False" />


            <!-- Takes keyboard input for the page's text fields -->
            <TextBox x:Name="KeyboardSink" Width="2" Height="2" Opacity="0"
                     HorizontalAlignment="Left" VerticalAlignment="Top"
                     IsHitTestVisible="False" IsTabStop="True"
                     IsTextPredictionEnabled="False" IsSpellCheckEnabled="False"
                     GotFocus="KeyboardSink_GotFocus" LostFocus="KeyboardSink_LostFocus"
                     TextChanged="KeyboardSink_TextChanged"
                     KeyDown="KeyboardSink_KeyDown" KeyUp="KeyboardSink_KeyUp" />

            <!-- Focus goes here to hide the keyboard (Grid can't take focus on 8.1) -->
            <Button x:Name="FocusSink" Width="1" Height="1" MinWidth="0" MinHeight="0"
                    Padding="0" BorderThickness="0" Opacity="0" IsHitTestVisible="False"
                    HorizontalAlignment="Right" VerticalAlignment="Top" />

            <Border x:Name="StatusPanel" Background="#E0141414" VerticalAlignment="Center"
                    Margin="24" Padding="20">
                <StackPanel>
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="White"
                               FontSize="20" Text="Starting..." />
                    <!-- Shown after a crash or when the engine doesn't come back -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="StatusButton1" Visibility="Collapsed" Margin="0,0,12,0"
                                Click="StatusButton_Click" />
                        <Button x:Name="StatusButton2" Visibility="Collapsed"
                                Click="StatusButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Tapping outside the open "..." menu closes it -->
        <Rectangle x:Name="MenuDismiss" Fill="Transparent" Visibility="Collapsed"
                   Tapped="MenuDismiss_Tapped" />

        <!-- Bottom bar, as IE on Windows Phone 8.1: the round tabs button on the left, the address
             field, and the small "..." at the top right. The "..." menu opens below the address row,
             as the app bar's menu does. -->
        <StackPanel x:Name="BottomBar" VerticalAlignment="Bottom"
                    Background="{ThemeResource PhoneChromeBrush}">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="BarShift" />
            </StackPanel.RenderTransform>

            <Grid>
                <!-- Address row -->
                <!-- Dragging the row up opens the "..." menu (MainPage.Chrome.cs, Bar_Manipulation*) -->
                <Grid x:Name="AddressRow" Height="60" ManipulationMode="TranslateY"
                      ManipulationStarted="Bar_ManipulationStarted"
                      ManipulationDelta="Bar_ManipulationDelta"
                      ManipulationCompleted="Bar_ManipulationCompleted">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Tabs: two pages in a circle, with the count when there's more than one -->
                    <Grid x:Name="TabsButton" Width="62" Height="60" Background="Transparent"
                          Tapped="TabsButton_Tapped" PointerPressed="Tilt_Pressed"
                          PointerReleased="Tilt_Released" PointerExited="Tilt_Released"
                          PointerCaptureLost="Tilt_Released">
                        <Ellipse Width="40" Height="40" StrokeThickness="2"
                                 Stroke="{ThemeResource PhoneForegroundBrush}" />
                        <Rectangle Width="13" Height="15" StrokeThickness="2" Margin="0,0,5,5"
                                   Stroke="{ThemeResource PhoneForegroundBrush}" />
                        <Rectangle Width="13" Height="15" Margin="6,6,0,0"
                                   Fill="{ThemeResource PhoneForegroundBrush}" />
                        <TextBlock x:Name="TabCount" Text="" FontSize="10" Margin="6,6,0,0"
                                   FontFamily="{ThemeResource PhoneFontFamilySemiBold}"
                                   Foreground="{ThemeResource PhoneChromeBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <TextBox x:Name="UrlBox" InputScope="Url" Margin="0" MinHeight="40" Height="40"
                                 Padding="8,5,40,4" FontSize="20" BorderThickness="0"
                                 Background="#FFD4D4D4" Foreground="#FF333333"
                                 FontFamily="{ThemeResource PhoneFontFamilyNormal}"
                                 PlaceholderText="browse or search"
                                 IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                                 KeyDown="UrlBox_KeyDown" GotFocus="UrlBox_GotFocus"
                                 LostFocus="UrlBox_LostFocus" />
                        <!-- Refresh, or stop while loading, inside the field; hold it for the
                             developer option. Hidden while the field is empty, as IE's. -->
                        <Grid x:Name="RefreshButton" Width="40" Height="40"
                              HorizontalAlignment="Right" Background="Transparent"
                              Tapped="RefreshButton_Tapped" Holding="RefreshButton_Holding"
                              PointerPressed="Tilt_Pressed" PointerReleased="Tilt_Released"
                              PointerExited="Tilt_Released" PointerCaptureLost="Tilt_Released">
                            <TextBlock x:Name="RefreshGlyph" Text="&#xE149;" FontFamily="Segoe UI Symbol"
                                       FontSize="20" Foreground="#FF1F1F1F"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>

                    <!-- "...": small, at the top right, as the app bar's -->
                    <Grid Grid.Column="2" Width="50" Height="60" Background="Transparent"
                          Tapped="MoreButton_Tapped">
                        <TextBlock Text="&#x2022;&#x2022;&#x2022;" FontSize="14" Margin="0,4,0,0"
                                   Foreground="{ThemeResource PhoneForegroundBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Top" />
                    </Grid>
                </Grid>

                <!-- Find on page: takes the address row's place -->
                <Grid x:Name="FindRow" Height="60" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FindBox" Margin="12,0,0,0" VerticalAlignment="Center" MinHeight="40"
                             Height="40" Padding="8,5,8,4" FontSize="20" BorderThickness="0"
                             Background="#FFD4D4D4" Foreground="#FF333333"
                             PlaceholderText="find on page" InputScope="Search"
                             KeyDown="FindBox_KeyDown" />
                    <Grid Grid.Column="1" MinWidth="64" Height="60" Background="Transparent"
                          Tapped="FindNext_Tapped" PointerPressed="Tilt_Pressed"
                          PointerReleased="Tilt_Released" PointerExited="Tilt_Released"
                          PointerCaptureLost="Tilt_Released">
                        <TextBlock Text="next" FontSize="20" FontFamily="{ThemeResource PhoneFontFamilyNormal}"
                                   Foreground="{ThemeResource PhoneForegroundBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Grid>

                <!-- Loading: a thin line in the accent color along the bar's top edge -->
                <ProgressBar x:Name="LoadProgress" VerticalAlignment="Top" Height="3" MinHeight="0"
                             Minimum="0" Maximum="100" Visibility="Collapsed"
                             Foreground="{ThemeResource PhoneAccentBrush}" Background="Transparent" />
            </Grid>

            <!-- The "..." menu, in IE's order (Metro UI skill, section 7); what doesn't apply to the page is dimmed -->
            <StackPanel x:Name="MenuPanel" Visibility="Collapsed" Margin="0,2,0,14"
                        Background="Transparent" ManipulationMode="TranslateY"
                        ManipulationStarted="Bar_ManipulationStarted"
                        ManipulationDelta="Bar_ManipulationDelta"
                        ManipulationCompleted="Bar_ManipulationCompleted">
                <TextBlock x:Name="MenuForward" Text="forward" Style="{StaticResource MenuItem}" Tapped="MenuForward_Tapped" />
                <TextBlock Text="recent" Style="{StaticResource MenuItem}" Tapped="MenuRecent_Tapped" />
                <TextBlock Text="favorites" Style="{StaticResource MenuItem}" Tapped="MenuFavorites_Tapped" />
                <TextBlock x:Name="MenuAddFavorite" Text="add to favorites" Style="{StaticResource MenuItem}" Tapped="MenuAddFavorite_Tapped" />
                <TextBlock x:Name="MenuShare" Text="share page" Style="{StaticResource MenuItem}" Tapped="MenuShare_Tapped" />
                <TextBlock x:Name="MenuFind" Text="find on page" Style="{StaticResource MenuItem}" Tapped="MenuFind_Tapped" />
                <TextBlock x:Name="MenuPin" Text="pin to start" Style="{StaticResource MenuItem}" Tapped="MenuPin_Tapped" />
                <TextBlock Text="settings" Style="{StaticResource MenuItem}" Tapped="MenuSettings_Tapped" />
            </StackPanel>
        </StackPanel>

        <!-- Full-screen pages (recent, favorites, settings), in the phone's theme -->
        <Grid x:Name="Sheet" Visibility="Collapsed" Background="{ThemeResource PhoneBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Margin="20,14,12,12">
                <TextBlock x:Name="SheetApp" Text="RETROFOX" FontSize="15"
                           FontFamily="{ThemeResource PhoneFontFamilySemiBold}"
                           Foreground="{ThemeResource PhoneForegroundBrush}" />
                <TextBlock x:Name="SheetTitle" FontSize="47" Margin="-2,-4,0,0"
                           FontFamily="{ThemeResource PhoneFontFamilySemiLight}"
                           Foreground="{ThemeResource PhoneForegroundBrush}" />
            </StackPanel>
            <ListView x:Name="SheetList" Grid.Row="1" Margin="20,0,12,0"
                      IsItemClickEnabled="True" ItemClick="SheetList_ItemClick"
                      SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,18" Background="Transparent" Holding="SheetItem_Holding">
                            <TextBlock Text="{Binding Title}" FontSize="22.67" TextTrimming="CharacterEllipsis"
                                       FontFamily="{ThemeResource PhoneFontFamilySemiLight}"
                                       Foreground="{ThemeResource PhoneForegroundBrush}" />
                            <TextBlock Text="{Binding Detail}" FontSize="15" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource PhoneMidBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="SheetEmpty" Grid.Row="1" Margin="20,0,20,0" FontSize="20"
                       TextWrapping="Wrap" Visibility="Collapsed"
                       Foreground="{ThemeResource PhoneMidBrush}" />
            <ScrollViewer x:Name="SettingsPanel" Grid.Row="1" Visibility="Collapsed" Margin="20,0,20,0">
                <StackPanel Margin="0,0,0,95">
                    <TextBlock Text="Home page" FontSize="15" Foreground="{ThemeResource PhoneMidBrush}" />
                    <TextBox x:Name="HomeBox" InputScope="Url" Margin="0,4,0,24"
                             LostFocus="HomeBox_LostFocus" />
                    <Button Content="delete history" Click="ClearHistory_Click" Margin="0,0,0,4" />
                    <TextBlock Text="Deletes the pages you've visited from recent." FontSize="15"
                               TextWrapping="Wrap" Margin="0,0,0,20"
                               Foreground="{ThemeResource PhoneMidBrush}" />
                    <Button Content="delete favorites" Click="ClearFavorites_Click" Margin="0,0,0,28" />
                    <TextBlock Text="About" FontSize="15" Foreground="{ThemeResource PhoneMidBrush}" />
                    <TextBlock x:Name="AboutText" TextWrapping="Wrap" FontSize="15" Margin="0,4,0,12"
                               Foreground="{ThemeResource PhoneForegroundBrush}" />
                    <Button Content="license notices" Click="Licenses_Click" Margin="0,0,0,4" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Tabs, as IE's: a pivot (phone, other) with a grid of tab thumbnails; + and "..." below -->
        <Grid x:Name="TabsPage" Visibility="Collapsed" Background="{ThemeResource PhoneBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Pivot x:Name="TabsPivot" Title="TABS">
                <PivotItem Header="phone" Margin="20,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="recent" FontSize="22.67" Margin="0,0,0,12"
                                   FontFamily="{ThemeResource PhoneFontFamilySemiLight}"
                                   Foreground="{ThemeResource PhoneMidBrush}" />
                        <GridView x:Name="TabsGrid" Grid.Row="1" SelectionMode="None"
                                  IsItemClickEnabled="True" ItemClick="TabsGrid_ItemClick">
                            <GridView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="144" Margin="0,0,16,18">
                                        <Grid Width="144" Height="123" Background="#FFC4C4C4">
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                                   VerticalAlignment="Top" />
                                            <Border BorderThickness="3" BorderBrush="{ThemeResource PhoneAccentBrush}"
                                                    Visibility="{Binding ActiveVisibility}" />
                                            <!-- The round x: 34 px to see, a 60 px square to hit (about 9 mm
                                                 on the phone), in the thumbnail's top right corner -->
                                            <Border Width="60" Height="60" Background="Transparent"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    PointerPressed="TabClose_PointerPressed"
                                                    Tapped="TabClose_Tapped">
                                                <Grid Width="34" Height="34" Margin="0,4,4,0"
                                                      HorizontalAlignment="Right" VerticalAlignment="Top">
                                                    <Ellipse Fill="White" Stroke="Black" StrokeThickness="2" />
                                                    <TextBlock Text="&#xE10A;" FontFamily="Segoe UI Symbol" FontSize="15"
                                                               Foreground="Black" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding Title}" FontSize="17" Margin="0,4,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontFamily="{ThemeResource PhoneFontFamilySemiBold}"
                                                   Foreground="{ThemeResource PhoneForegroundBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </Grid>
                </PivotItem>
                <PivotItem Header="other" Margin="20,0,12,0">
                    <TextBlock Text="Tabs open on your other devices would show up here. Retrofox keeps tabs on this phone only."
                               FontSize="20" TextWrapping="Wrap" Foreground="{ThemeResource PhoneMidBrush}" />
                </PivotItem>
            </Pivot>
            <!-- The tabs page's app bar: + new, and "..." with close all -->
            <StackPanel Grid.Row="1" Background="{ThemeResource PhoneChromeBrush}">
                <Grid Height="60">
                    <StackPanel HorizontalAlignment="Center" Background="Transparent"
                                Tapped="NewTab_Tapped" PointerPressed="Tilt_Pressed"
                                PointerReleased="Tilt_Released" PointerExited="Tilt_Released"
                                PointerCaptureLost="Tilt_Released">
                        <Grid Width="40" Height="40" Margin="0,4,0,0">
                            <Ellipse StrokeThickness="2" Stroke="{ThemeResource PhoneForegroundBrush}" />
                            <TextBlock Text="&#xE109;" FontFamily="Segoe UI Symbol" FontSize="18"
                                       Foreground="{ThemeResource PhoneForegroundBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock x:Name="NewTabLabel" Text="new" FontSize="11" HorizontalAlignment="Center"
                                   Visibility="Collapsed" Foreground="{ThemeResource PhoneForegroundBrush}" />
                    </StackPanel>
                    <Grid Width="50" Height="60" HorizontalAlignment="Right" Background="Transparent"
                          Tapped="TabsMore_Tapped">
                        <TextBlock Text="&#x2022;&#x2022;&#x2022;" FontSize="14" Margin="0,4,0,0"
                                   Foreground="{ThemeResource PhoneForegroundBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Top" />
                    </Grid>
                </Grid>
                <StackPanel x:Name="TabsMenu" Visibility="Collapsed" Margin="0,0,0,14">
                    <TextBlock Text="close all" Style="{StaticResource MenuItem}" Tapped="CloseAllTabs_Tapped" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
