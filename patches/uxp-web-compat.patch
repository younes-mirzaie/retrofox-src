+namespace {
+
+// Settles one img.decode() promise on the image's next load or error event
+class ImageDecodeListener final : public nsIDOMEventListener
+{
+public:
+  NS_DECL_ISUPPORTS
+
+  ImageDecodeListener(HTMLImageElement* aImage, Promise* aPromise)
+    : mImage(aImage), mPromise(aPromise) {}
+
+  NS_IMETHOD HandleEvent(nsIDOMEvent* aEvent) override
+  {
+    RefPtr<ImageDecodeListener> kungFuDeathGrip = this;
+    mImage->RemoveSystemEventListener(NS_LITERAL_STRING("load"), this, false);
+    mImage->RemoveSystemEventListener(NS_LITERAL_STRING("error"), this, false);
+    nsAutoString type;
+    aEvent->GetType(type);
+    if (type.EqualsLiteral("load")) {
+      mPromise->MaybeResolveWithUndefined();
+    } else {
+      mPromise->MaybeReject(NS_ERROR_DOM_ENCODING_NOT_SUPPORTED_ERR);
+    }
+    return NS_OK;
+  }
+
+private:
+  ~ImageDecodeListener() {}
+
+  RefPtr<HTMLImageElement> mImage;
+  RefPtr<Promise> mPromise;
+};
+
+NS_IMPL_ISUPPORTS(ImageDecodeListener, nsIDOMEventListener)
+
+} // namespace
+
+// img.decode(): resolves once the image is available to draw, rejects (EncodingError) if it
+// can't be. Gecko decodes when it paints, so "available" is the load event (or already
+// complete with a size).
+already_AddRefed<Promise>
+HTMLImageElement::Decode(ErrorResult& aRv)
+{
+  nsCOMPtr<nsIGlobalObject> global = OwnerDoc()->GetScopeObject();
+  if (!global) {
+    aRv.Throw(NS_ERROR_UNEXPECTED);
+    return nullptr;
+  }
+  RefPtr<Promise> promise = Promise::Create(global, aRv);
+  if (aRv.Failed()) {
+    return nullptr;
+  }
+  if (!OwnerDoc()->IsCurrentActiveDocument()) {
+    promise->MaybeReject(NS_ERROR_DOM_ENCODING_NOT_SUPPORTED_ERR);
+    return promise.forget();
+  }
+  if (Complete()) {
+    if (NaturalWidth() > 0 || NaturalHeight() > 0) {
+      promise->MaybeResolveWithUndefined();
+    } else {
+      // no image, or a broken one
+      promise->MaybeReject(NS_ERROR_DOM_ENCODING_NOT_SUPPORTED_ERR);
+    }
+    return promise.forget();
+  }
+  RefPtr<ImageDecodeListener> listener = new ImageDecodeListener(this, promise);
+  AddSystemEventListener(NS_LITERAL_STRING("load"), listener, false);
+  AddSystemEventListener(NS_LITERAL_STRING("error"), listener, false);
+  return promise.forget();
+}
+
 bool
 HTMLImageElement::Complete()
 {
