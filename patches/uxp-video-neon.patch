 elif CONFIG['CPU_ARCH'] == 'arm' and CONFIG['OS_TARGET'] == 'WINNT':
-    # Windows on ARM (retrofox): portable C, with Win32 threads instead of pthreads
+    # Windows on ARM (retrofox): NEON through the C intrinsics versions only. The .asm ones are
+    # ARM-state code (and GNU-converted ADS syntax), while Windows runs Thumb-2. Every Windows
+    # Phone has NEON, so no runtime detection: config/win/arm/*_rtcd.h (rtcd.pl --arch=armv7
+    # --disable-neon_asm) call the NEON versions directly. Win32 threads instead of pthreads.
