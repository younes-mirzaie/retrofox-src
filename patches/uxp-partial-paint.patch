+// retrofox: paint only the invalidated rectangle (SetRetrofoxFullPaint(true) paints everything
+// every time, as before, to compare)
+static bool sFullPaint = false;
+
+void
+mozilla::widget::SetRetrofoxFullPaint(bool aFull)
+{
+  sFullPaint = aFull;
+}
+
+static uint32_t sPaintCount = 0;
+static double sPaintMs = 0;
+static double sPaintDirtyShare = 0;
+
+static double
+PaintClockMs()
+{
+  LARGE_INTEGER t, f;
+  QueryPerformanceCounter(&t);
+  QueryPerformanceFrequency(&f);
+  return double(t.QuadPart) * 1000.0 / double(f.QuadPart);
+}
+
+void
+mozilla::widget::TakeRetrofoxPaintStats(uint32_t* aCount, double* aMs, uint32_t* aDirtyPercent)
+{
+  *aCount = sPaintCount;
+  *aMs = sPaintMs;
+  *aDirtyPercent = sPaintCount ? uint32_t(sPaintDirtyShare * 100 / sPaintCount) : 0;
+  sPaintCount = 0;
+  sPaintMs = sPaintDirtyShare = 0;
+}
