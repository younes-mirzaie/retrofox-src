+// Who handles the current touch drag. A touch goes to the page as touch events (down, moves, up);
+// once it has moved a little, it is the page's if the page cancelled the touch (preventDefault) or
+// CSS touch-action rules out panning that way, otherwise the browser scrolls (and a short touch
+// that hardly moved is a tap: a click follows it).
+enum RetrofoxGesture {
+  eRetrofoxGestureNone,       // no finger down
+  eRetrofoxGestureUndecided,  // down, not moved far enough yet
+  eRetrofoxGestureBrowser,    // the browser scrolls (DispatchRetrofoxScroll applies)
+  eRetrofoxGesturePage        // the page handles it (scrolling is ignored until the finger lifts)
+};
+RetrofoxGesture GetRetrofoxGesture();
