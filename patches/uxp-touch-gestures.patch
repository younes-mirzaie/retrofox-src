+// The touch-action that applies at a point: the element's and its ancestors' together (each can
+// only take away ways of panning)
+static uint32_t
+TouchActionAt(nsWindow* aTarget, const LayoutDeviceIntPoint& aPoint)
+{
+  nsIWidgetListener* listener = aTarget->GetWidgetListener();
+  nsIPresShell* presShell = listener ? listener->GetPresShell() : nullptr;
+  nsIFrame* root = presShell ? presShell->GetRootFrame() : nullptr;
+  if (!root) {
+    return NS_STYLE_TOUCH_ACTION_AUTO;
+  }
+  nsPresContext* pc = root->PresContext();
+  nsPoint pt(pc->DevPixelsToAppUnits(aPoint.x), pc->DevPixelsToAppUnits(aPoint.y));
+  nsIFrame* frame = nsLayoutUtils::GetFrameForPoint(root, pt);
+  bool panX = true, panY = true;
+  for (nsIFrame* f = frame; f; f = nsLayoutUtils::GetCrossDocParentFrame(f)) {
+    uint32_t ta = nsLayoutUtils::GetTouchActionFromFrame(f);
+    if (ta & NS_STYLE_TOUCH_ACTION_NONE) {
+      panX = panY = false;
+    } else if (!(ta & (NS_STYLE_TOUCH_ACTION_AUTO | NS_STYLE_TOUCH_ACTION_MANIPULATION))) {
+      panX = panX && (ta & NS_STYLE_TOUCH_ACTION_PAN_X);
+      panY = panY && (ta & NS_STYLE_TOUCH_ACTION_PAN_Y);
+    }
+  }
+  if (panX && panY) {
+    return NS_STYLE_TOUCH_ACTION_AUTO;
+  }
+  if (!panX && !panY) {
+    return NS_STYLE_TOUCH_ACTION_NONE;
+  }
+  return panX ? NS_STYLE_TOUCH_ACTION_PAN_X : NS_STYLE_TOUCH_ACTION_PAN_Y;
+}
+
+static nsEventStatus
+DispatchTouch(nsWindow* aTarget, EventMessage aMessage, const LayoutDeviceIntPoint& aPoint)
+{
+  WidgetTouchEvent touchEvent(true, aMessage, aTarget);
+  touchEvent.mTime = PR_IntervalNow();
+  touchEvent.mTouches.AppendElement(
+    new dom::Touch(0, aPoint, LayoutDeviceIntPoint(1, 1), 0.0f, 1.0f));
+  nsEventStatus status = nsEventStatus_eIgnore;
+  aTarget->DispatchEvent(&touchEvent, status);
+  return status;
+}
