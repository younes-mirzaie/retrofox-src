diff --git a/xpcom/reflect/xptcall/md/win32/xptc_arm_win_abi.h b/xpcom/reflect/xptcall/md/win32/xptc_arm_win_abi.h
new file mode 100644
index 0000000..379693d
--- /dev/null
+++ b/xpcom/reflect/xptcall/md/win32/xptc_arm_win_abi.h
@@ -0,0 +1,106 @@
+/* -*- Mode: C++; tab-width: 8; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/* retrofox: argument placement for Windows on ARM (32-bit, Thumb-2).
+ *
+ * Windows on ARM uses the AAPCS with the VFP ("hard float") variant:
+ *   - core registers r0-r3 carry integer/pointer arguments; r0 is |this|,
+ *   - 64-bit integers go in an even:odd register pair (r2:r3), or 8-byte
+ *     aligned on the stack; once one has gone to the stack, no later
+ *     argument may use a core register (no back-filling),
+ *   - float/double go in s0-s15 / d0-d7, with back-filling of single
+ *     precision holes; once a VFP argument has gone to the stack, no later
+ *     VFP argument may use a VFP register,
+ *   - stack arguments are 4-byte slots, 64-bit ones 8-byte aligned.
+ *
+ * Both NS_InvokeByIndex (writing arguments) and PrepareAndDispatch
+ * (reading them) use this one allocator, so the two directions can't drift.
+ */
+
+#ifndef xptc_arm_win_abi_h___
+#define xptc_arm_win_abi_h___
+
+#include <stdint.h>
+
+namespace xptc_arm {
+
+enum ArgClass { kWord, kDword, kFloat, kDouble };
+
+enum ArgWhere { kInGpr, kInVfp, kOnStack };
+
+struct ArgSlot {
+    ArgWhere where;
+    uint32_t index;   // kInGpr: core register number (1..3, or 2 for a pair)
+                      // kInVfp: single-precision register number (0..15)
+                      // kOnStack: 32-bit word offset from the outgoing SP
+};
+
+class ArgAllocator {
+public:
+    ArgAllocator() : mNextGpr(1), mVfpUsed(0), mVfpDone(false), mStackWords(0) {}
+
+    ArgSlot Next(ArgClass c) {
+        ArgSlot s;
+        switch (c) {
+        case kWord:
+            if (mNextGpr < 4) {
+                s.where = kInGpr; s.index = mNextGpr++;
+            } else {
+                s.where = kOnStack; s.index = mStackWords++;
+            }
+            return s;
+        case kDword:
+            mNextGpr = (mNextGpr + 1) & ~1u;
+            if (mNextGpr + 1 < 4) {
+                s.where = kInGpr; s.index = mNextGpr; mNextGpr += 2;
+            } else {
+                mNextGpr = 4;
+                mStackWords = (mStackWords + 1) & ~1u;
+                s.where = kOnStack; s.index = mStackWords; mStackWords += 2;
+            }
+            return s;
+        case kFloat:
+            if (!mVfpDone) {
+                for (uint32_t r = 0; r < 16; r++) {
+                    if (!(mVfpUsed & (1u << r))) {
+                        mVfpUsed |= 1u << r;
+                        s.where = kInVfp; s.index = r;
+                        return s;
+                    }
+                }
+                mVfpDone = true;
+            }
+            s.where = kOnStack; s.index = mStackWords++;
+            return s;
+        case kDouble:
+        default:
+            if (!mVfpDone) {
+                for (uint32_t r = 0; r < 16; r += 2) {
+                    if (!(mVfpUsed & (3u << r))) {
+                        mVfpUsed |= 3u << r;
+                        s.where = kInVfp; s.index = r;
+                        return s;
+                    }
+                }
+                mVfpDone = true;
+            }
+            mStackWords = (mStackWords + 1) & ~1u;
+            s.where = kOnStack; s.index = mStackWords; mStackWords += 2;
+            return s;
+        }
+    }
+
+    uint32_t StackWords() const { return mStackWords; }
+
+private:
+    uint32_t mNextGpr;
+    uint32_t mVfpUsed;     // bit n = s<n> taken
+    bool     mVfpDone;
+    uint32_t mStackWords;
+};
+
+} // namespace xptc_arm
+
+#endif /* xptc_arm_win_abi_h___ */
diff --git a/xpcom/reflect/xptcall/md/win32/xptcinvoke_arm_win.cpp b/xpcom/reflect/xptcall/md/win32/xptcinvoke_arm_win.cpp
new file mode 100644
index 0000000..51a6f6a
--- /dev/null
+++ b/xpcom/reflect/xptcall/md/win32/xptcinvoke_arm_win.cpp
@@ -0,0 +1,176 @@
+/* -*- Mode: C; tab-width: 8; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/* retrofox: invoke XPCOM methods on native objects, Windows on ARM (Thumb-2,
+ * AAPCS-VFP, MSVC C++ ABI, built with clang-cl). See xptc_arm_win_abi.h. */
+
+#include "xptcprivate.h"
+#include "xptc_arm_win_abi.h"
+
+#if !defined(_M_ARM) && !defined(XPTC_ARM_WIN_TEST)
+#error "This file is for 32-bit Windows on ARM"
+#endif
+#if !defined(__clang__)
+#error "Needs clang (GNU-style inline assembly)"
+#endif
+
+using namespace xptc_arm;
+
+// Calls |func(that, ...)| with r1-r3 = gpr[1..3], d0-d7 = vfp[0..7] and
+// |stackWords| words from |stack| at the outgoing SP. Defined below.
+extern "C" uint32_t
+xptc_arm_win_invoke(void* func, nsISupports* that, const uint32_t* gpr,
+                    const uint64_t* vfp, const uint32_t* stack,
+                    uint32_t stackWords);
+
+static void
+PutWord(const ArgSlot& s, uint32_t* gpr, float* vfp, uint32_t* stack, uint32_t v)
+{
+    switch (s.where) {
+    case kInGpr:  gpr[s.index] = v; break;
+    case kInVfp:  reinterpret_cast<uint32_t*>(vfp)[s.index] = v; break;
+    case kOnStack: stack[s.index] = v; break;
+    }
+}
+
+static void
+PutDword(const ArgSlot& s, uint32_t* gpr, float* vfp, uint32_t* stack, uint64_t v)
+{
+    uint32_t lo = uint32_t(v), hi = uint32_t(v >> 32);
+    switch (s.where) {
+    case kInGpr:   gpr[s.index] = lo; gpr[s.index + 1] = hi; break;
+    case kInVfp: {
+        uint32_t* w = reinterpret_cast<uint32_t*>(vfp);
+        w[s.index] = lo; w[s.index + 1] = hi;
+        break;
+    }
+    case kOnStack: stack[s.index] = lo; stack[s.index + 1] = hi; break;
+    }
+}
+
+EXPORT_XPCOM_API(nsresult)
+NS_InvokeByIndex(nsISupports* that, uint32_t methodIndex,
+                 uint32_t paramCount, nsXPTCVariant* params)
+{
+    // Worst case each parameter takes two stack words plus one alignment word.
+    const uint32_t kInline = 64;
+    uint32_t stackInline[kInline];
+    uint32_t needed = paramCount * 3 + 1;
+    uint32_t* stack = needed <= kInline ? stackInline : new uint32_t[needed];
+
+    uint32_t gpr[4] = { 0, 0, 0, 0 };
+    uint64_t vfpRegs[8] = { 0, 0, 0, 0, 0, 0, 0, 0 };
+    float* vfp = reinterpret_cast<float*>(vfpRegs);
+
+    ArgAllocator alloc;
+    nsXPTCVariant* s = params;
+    for (uint32_t i = 0; i < paramCount; i++, s++) {
+        if (s->IsPtrData()) {
+            PutWord(alloc.Next(kWord), gpr, vfp, stack, uint32_t(uintptr_t(s->ptr)));
+            continue;
+        }
+        // AAPCS: integral types narrower than a word are sign/zero-extended.
+        switch (s->type) {
+        case nsXPTType::T_I8:   PutWord(alloc.Next(kWord), gpr, vfp, stack, uint32_t(int32_t(s->val.i8)));  break;
+        case nsXPTType::T_I16:  PutWord(alloc.Next(kWord), gpr, vfp, stack, uint32_t(int32_t(s->val.i16))); break;
+        case nsXPTType::T_I32:  PutWord(alloc.Next(kWord), gpr, vfp, stack, uint32_t(s->val.i32));          break;
+        case nsXPTType::T_U8:   PutWord(alloc.Next(kWord), gpr, vfp, stack, s->val.u8);                     break;
+        case nsXPTType::T_U16:  PutWord(alloc.Next(kWord), gpr, vfp, stack, s->val.u16);                    break;
+        case nsXPTType::T_U32:  PutWord(alloc.Next(kWord), gpr, vfp, stack, s->val.u32);                    break;
+        case nsXPTType::T_BOOL: PutWord(alloc.Next(kWord), gpr, vfp, stack, s->val.b ? 1 : 0);              break;
+        case nsXPTType::T_CHAR: PutWord(alloc.Next(kWord), gpr, vfp, stack, uint32_t(int32_t(s->val.c)));   break;
+        case nsXPTType::T_WCHAR: PutWord(alloc.Next(kWord), gpr, vfp, stack, uint32_t(s->val.wc));          break;
+        case nsXPTType::T_I64:  PutDword(alloc.Next(kDword), gpr, vfp, stack, uint64_t(s->val.i64));        break;
+        case nsXPTType::T_U64:  PutDword(alloc.Next(kDword), gpr, vfp, stack, s->val.u64);                  break;
+        case nsXPTType::T_FLOAT: {
+            uint32_t bits;
+            __builtin_memcpy(&bits, &s->val.f, 4);
+            PutWord(alloc.Next(kFloat), gpr, vfp, stack, bits);
+            break;
+        }
+        case nsXPTType::T_DOUBLE: {
+            uint64_t bits;
+            __builtin_memcpy(&bits, &s->val.d, 8);
+            PutDword(alloc.Next(kDouble), gpr, vfp, stack, bits);
+            break;
+        }
+        default:
+            // all the others are plain pointer types
+            PutWord(alloc.Next(kWord), gpr, vfp, stack, uint32_t(uintptr_t(s->val.p)));
+            break;
+        }
+    }
+
+    void** vtable = *reinterpret_cast<void***>(that);
+    uint32_t result = xptc_arm_win_invoke(vtable[methodIndex], that, gpr,
+                                          vfpRegs, stack, alloc.StackWords());
+    if (stack != stackInline)
+        delete [] stack;
+    return nsresult(result);
+}
+
+/*
+ * r0 = func, r1 = that, r2 = gpr, r3 = vfp, [sp] = stack, [sp+4] = stackWords
+ *
+ * Keeps SP 8-byte aligned at the call (AAPCS). The outgoing area is at most
+ * 255 * 8 + 4 bytes, under one 4 KB page, so no __chkstk probe is needed.
+ * r11 points at the saved {r11, lr} pair, as Windows on ARM expects, and r4
+ * keeps the SP from the end of the prologue (the .seh_save_sp unwind code),
+ * so the Windows unwinder can walk through this frame.
+ */
+#ifdef _WIN32
+#define SEH(x) x "\n"
+#else
+#define SEH(x)
+#endif
+__asm__(
+    ".text\n"
+    ".syntax unified\n"
+    ".thumb\n"
+#ifdef _WIN32
+    ".def xptc_arm_win_invoke\n"
+    ".scl 2\n"
+    ".type 32\n"
+    ".endef\n"
+#else
+    ".type xptc_arm_win_invoke, %function\n"
+#endif
+    ".globl xptc_arm_win_invoke\n"
+    ".p2align 2\n"
+    ".thumb_func\n"
+    "xptc_arm_win_invoke:\n"
+    SEH(".seh_proc xptc_arm_win_invoke")
+    "    push    {r4, r5, r6, r7, r11, lr}\n"
+    SEH(".seh_save_regs_w {r4-r7, r11, lr}")
+    "    add     r11, sp, #16\n"
+    SEH(".seh_nop_w")
+    "    mov     r4, sp\n"
+    SEH(".seh_save_sp r4")
+    SEH(".seh_endprologue")
+    "    ldr     r5, [r4, #24]\n"         // stack
+    "    ldr     r12, [r4, #28]\n"        // stackWords
+    "    mov     r6, r0\n"                // func
+    "    mov     r7, r1\n"                // that
+    "    vldmia  r3, {d0-d7}\n"
+    "    lsl     r0, r12, #2\n"
+    "    adds    r0, r0, #7\n"
+    "    bic     r0, r0, #7\n"
+    "    sub     sp, sp, r0\n"
+    "    mov     r0, sp\n"
+    "    cmp     r12, #0\n"
+    "    beq     2f\n"
+    "1:  ldr     r1, [r5], #4\n"
+    "    str     r1, [r0], #4\n"
+    "    subs    r12, r12, #1\n"
+    "    bne     1b\n"
+    "2:  ldr     r1, [r2, #4]\n"
+    "    ldr     r3, [r2, #12]\n"
+    "    ldr     r2, [r2, #8]\n"
+    "    mov     r0, r7\n"
+    "    blx     r6\n"
+    "    mov     sp, r4\n"                // r0 holds the result
+    "    pop     {r4, r5, r6, r7, r11, pc}\n"
+    SEH(".seh_endproc")
+);
diff --git a/xpcom/reflect/xptcall/md/win32/xptcstubs_arm_win.cpp b/xpcom/reflect/xptcall/md/win32/xptcstubs_arm_win.cpp
new file mode 100644
index 0000000..e19f58c
--- /dev/null
+++ b/xpcom/reflect/xptcall/md/win32/xptcstubs_arm_win.cpp
@@ -0,0 +1,197 @@
+/* -*- Mode: C; tab-width: 8; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/* retrofox: shared vtbl stubs, Windows on ARM (Thumb-2, AAPCS-VFP, MSVC C++
+ * ABI, built with clang-cl). See xptc_arm_win_abi.h. */
+
+#include "xptcprivate.h"
+#include "xptiprivate.h"
+#include "xptc_arm_win_abi.h"
+
+#if !defined(_M_ARM) && !defined(XPTC_ARM_WIN_TEST)
+#error "This file is for 32-bit Windows on ARM"
+#endif
+#if !defined(__clang__)
+#error "Needs clang (GNU-style inline assembly, naked functions)"
+#endif
+
+using namespace xptc_arm;
+
+/*
+ * gpr   = the caller's r0-r3 (gpr[0] is |this|)
+ * vfp   = the caller's d0-d7 (as s0-s15)
+ * stack = the caller's stack arguments
+ */
+extern "C" nsresult
+xptc_arm_win_PrepareAndDispatch(nsXPTCStubBase* self, uint32_t methodIndex,
+                                const uint32_t* gpr, const uint32_t* vfp,
+                                const uint32_t* stack)
+{
+#define PARAM_BUFFER_COUNT 16
+
+    nsXPTCMiniVariant paramBuffer[PARAM_BUFFER_COUNT];
+    nsXPTCMiniVariant* dispatchParams = nullptr;
+    const nsXPTMethodInfo* info = nullptr;
+    uint8_t paramCount;
+    nsresult result = NS_ERROR_FAILURE;
+
+    NS_ASSERTION(self, "no self");
+
+    self->mEntry->GetMethodInfo(uint16_t(methodIndex), &info);
+    NS_ASSERTION(info, "no method info");
+    if (!info)
+        return NS_ERROR_UNEXPECTED;
+
+    paramCount = info->GetParamCount();
+
+    if (paramCount > PARAM_BUFFER_COUNT)
+        dispatchParams = new nsXPTCMiniVariant[paramCount];
+    else
+        dispatchParams = paramBuffer;
+
+    ArgAllocator alloc;
+    for (uint8_t i = 0; i < paramCount; i++) {
+        const nsXPTParamInfo& param = info->GetParam(i);
+        const nsXPTType& type = param.GetType();
+        nsXPTCMiniVariant* dp = &dispatchParams[i];
+
+        ArgClass cls = kWord;
+        bool isPtr = param.IsOut() || !type.IsArithmetic();
+        if (!isPtr) {
+            switch (type) {
+            case nsXPTType::T_I64:
+            case nsXPTType::T_U64:    cls = kDword;  break;
+            case nsXPTType::T_FLOAT:  cls = kFloat;  break;
+            case nsXPTType::T_DOUBLE: cls = kDouble; break;
+            default:                  cls = kWord;   break;
+            }
+        }
+
+        ArgSlot slot = alloc.Next(cls);
+        const uint32_t* src;
+        switch (slot.where) {
+        case kInGpr:  src = &gpr[slot.index];   break;
+        case kInVfp:  src = &vfp[slot.index];   break;
+        default:      src = &stack[slot.index]; break;
+        }
+        uint32_t w = src[0];
+
+        if (isPtr) {
+            dp->val.p = reinterpret_cast<void*>(uintptr_t(w));
+            continue;
+        }
+
+        switch (type) {
+        case nsXPTType::T_I8:    dp->val.i8  = int8_t(w);   break;
+        case nsXPTType::T_I16:   dp->val.i16 = int16_t(w);  break;
+        case nsXPTType::T_I32:   dp->val.i32 = int32_t(w);  break;
+        case nsXPTType::T_U8:    dp->val.u8  = uint8_t(w);  break;
+        case nsXPTType::T_U16:   dp->val.u16 = uint16_t(w); break;
+        case nsXPTType::T_U32:   dp->val.u32 = w;           break;
+        case nsXPTType::T_BOOL:  dp->val.b   = uint8_t(w) != 0; break;
+        case nsXPTType::T_CHAR:  dp->val.c   = char(w);     break;
+        case nsXPTType::T_WCHAR: dp->val.wc  = char16_t(w); break;
+        case nsXPTType::T_I64:
+        case nsXPTType::T_U64:
+            dp->val.u64 = uint64_t(src[0]) | (uint64_t(src[1]) << 32);
+            break;
+        case nsXPTType::T_FLOAT:
+            __builtin_memcpy(&dp->val.f, src, 4);
+            break;
+        case nsXPTType::T_DOUBLE:
+            __builtin_memcpy(&dp->val.d, src, 8);
+            break;
+        default:
+            NS_ERROR("bad type");
+            break;
+        }
+    }
+
+    result = self->mOuter->CallMethod(uint16_t(methodIndex), info, dispatchParams);
+
+    if (dispatchParams != paramBuffer)
+        delete [] dispatchParams;
+
+    return result;
+}
+
+/*
+ * The shared stub. Entered from StubN with ip = N and every argument
+ * register untouched.
+ *
+ *   push {r0-r3}       caller's core argument registers   (sp+80..95 later)
+ *   vpush {d0-d7}      caller's VFP argument registers     (sp+16..79 later)
+ *   push {r11, lr}                                         (sp+8..15 later)
+ *   sub sp, #8         5th C argument of PrepareAndDispatch (sp+0)
+ * The caller's stack arguments then start at sp+96. Every step is a multiple
+ * of 8 bytes, so SP stays 8-byte aligned. The .seh_ lines give the Windows
+ * unwinder the same layout.
+ */
+#ifdef _WIN32
+#define SEH(x) x "\n"
+#else
+#define SEH(x)
+#endif
+__asm__(
+    ".text\n"
+    ".syntax unified\n"
+    ".thumb\n"
+#ifdef _WIN32
+    ".def xptc_arm_win_SharedStub\n"
+    ".scl 2\n"
+    ".type 32\n"
+    ".endef\n"
+#else
+    ".type xptc_arm_win_SharedStub, %function\n"
+#endif
+    ".globl xptc_arm_win_SharedStub\n"
+    ".p2align 2\n"
+    ".thumb_func\n"
+    "xptc_arm_win_SharedStub:\n"
+    SEH(".seh_proc xptc_arm_win_SharedStub")
+    "    push    {r0, r1, r2, r3}\n"
+    SEH(".seh_save_regs {r0-r3}")
+    "    vpush   {d0-d7}\n"
+    SEH(".seh_save_fregs {d0-d7}")
+    "    push    {r11, lr}\n"
+    SEH(".seh_save_regs_w {r11, lr}")
+    "    mov     r11, sp\n"
+    SEH(".seh_nop")
+    "    sub     sp, sp, #8\n"
+    SEH(".seh_stackalloc 8")
+    SEH(".seh_endprologue")
+    "    mov     r1, ip\n"                 // methodIndex
+    "    add     r2, sp, #80\n"            // gpr (r0-r3)
+    "    add     r3, sp, #16\n"            // vfp (d0-d7)
+    "    add     ip, sp, #96\n"            // caller's stack arguments
+    "    str     ip, [sp]\n"
+    "    bl      xptc_arm_win_PrepareAndDispatch\n"   // r0 is still |self|
+    "    add     sp, sp, #8\n"
+    "    pop     {r11, lr}\n"
+    "    add     sp, sp, #80\n"
+    "    bx      lr\n"
+    SEH(".seh_endproc")
+);
+
+/*
+ * Each stub only loads its method number into ip (r12, the intra-procedure
+ * scratch register, free to clobber at a call) and jumps to the shared stub.
+ * Naked member functions let the compiler produce the MSVC-mangled names.
+ */
+#define STUB_ENTRY(n)                                           \
+__attribute__((naked)) nsresult nsXPTCStubBase::Stub##n()      \
+{                                                               \
+    __asm__ volatile("mov.w   ip, #" #n "\n"                    \
+                     "b.w     xptc_arm_win_SharedStub\n");      \
+}
+
+#define SENTINEL_ENTRY(n)                                       \
+nsresult nsXPTCStubBase::Sentinel##n()                          \
+{                                                               \
+    NS_ERROR("nsXPTCStubBase::Sentinel called");                \
+    return NS_ERROR_NOT_IMPLEMENTED;                            \
+}
+
+#include "xptcstubsdef.inc"
