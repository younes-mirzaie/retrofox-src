@@ -0,0 +1,16 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/* Embeds the ICU data file for clang-cl builds without yasm or a GNU assembler,
+ * using clang's integrated assembler (same idea as icudata_gas.S). */
+
+#define RFX_STR2(x) #x
+#define RFX_STR(x) RFX_STR2(x)
+
+__asm__(
+    ".section .rdata,\"dr\"\n"
+    ".globl " RFX_STR(ICU_DATA_SYMBOL) "\n"
+    ".balign 16\n"
+    RFX_STR(ICU_DATA_SYMBOL) ":\n"
+    ".incbin " RFX_STR(ICU_DATA_FILE) "\n");
