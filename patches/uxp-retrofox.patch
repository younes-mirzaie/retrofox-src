+// The phone engine has no Win32 windows and so no message queue: native "events" are just a
+// Win32 event that wakes the main thread when Gecko has work (ScheduleNativeEventCallback).
+class nsAppShell : public nsBaseAppShell
+{
+public:
+  nsAppShell();
+
+  nsresult Init();
+
+protected:
+  virtual ~nsAppShell();
+
+  virtual void ScheduleNativeEventCallback() override;
