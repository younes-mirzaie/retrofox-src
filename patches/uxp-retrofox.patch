+nsresult
+nsLookAndFeel::NativeGetColor(ColorID aID, nscolor& aResult)
+{
+  switch (aID) {
+    case eColorID_TextSelectBackground:
+    case eColorID_IMESelectedRawTextBackground:
+    case eColorID_IMESelectedConvertedTextBackground:
+    case eColorID_highlight:
+    case eColorID__moz_menuhover:
+    case eColorID__moz_html_cellhighlight:
+    case eColorID__moz_mac_focusring:
+    case eColorID__moz_nativehyperlinktext:
+      aResult = RFX_ACCENT;
+      break;
+    case eColorID_TextSelectForeground:
+    case eColorID_IMESelectedRawTextForeground:
+    case eColorID_IMESelectedConvertedTextForeground:
+    case eColorID_highlighttext:
+    case eColorID__moz_menuhovertext:
+    case eColorID__moz_html_cellhighlighttext:
+      aResult = NS_RGB(0xFF, 0xFF, 0xFF);
+      break;
+    case eColorID_WindowBackground:
+    case eColorID_TextBackground:
+    case eColorID_window:
+    case eColorID_background:
+    case eColorID__moz_field:
+    case eColorID__moz_combobox:
+    case eColorID__moz_dialog:
+    case eColorID_menu:
+    case eColorID_infobackground:
+    case eColorID_buttonhighlight:
+    case eColorID_threedhighlight:
+    case eColorID_threedlightshadow:
+      aResult = NS_RGB(0xFF, 0xFF, 0xFF);
+      break;
+    case eColorID_buttonface:
+    case eColorID_threedface:
+    case eColorID__moz_buttondefault:
+    case eColorID_scrollbar:
+    case eColorID_appworkspace:
+    case eColorID_inactiveborder:
+    case eColorID_inactivecaption:
+      aResult = NS_RGB(0xE6, 0xE6, 0xE6);
+      break;
+    case eColorID_buttonshadow:
+    case eColorID_threedshadow:
+    case eColorID_graytext:
+    case eColorID_inactivecaptiontext:
+      aResult = NS_RGB(0x99, 0x99, 0x99);
+      break;
+    case eColorID_threeddarkshadow:
+    case eColorID_activeborder:
+    case eColorID_windowframe:
+      aResult = NS_RGB(0x40, 0x40, 0x40);
+      break;
+    case eColorID_activecaption:
+      aResult = RFX_ACCENT;
+      break;
+    case eColorID_SpellCheckerUnderline:
+      aResult = NS_RGB(0xFF, 0x00, 0x00);
+      break;
+    default:
+      // Text colors and everything else: black on white
+      aResult = NS_RGB(0x00, 0x00, 0x00);
+      break;
+  }
+  return NS_OK;
+}
+
+nsresult
+nsLookAndFeel::GetIntImpl(IntID aID, int32_t& aResult)
+{
+  nsresult rv = nsXPLookAndFeel::GetIntImpl(aID, aResult);
+  if (NS_SUCCEEDED(rv)) {
+    return rv;
+  }
+  rv = NS_OK;
+  switch (aID) {
+    case eIntID_CaretBlinkTime:
+      aResult = 567;
+      break;
+    case eIntID_CaretWidth:
+      aResult = 2;
+      break;
+    case eIntID_ShowCaretDuringSelection:
+    case eIntID_SelectTextfieldsOnKeyFocus:
+    case eIntID_SubmenuDelay:
+    case eIntID_MenusCanOverlapOSBar:
+    case eIntID_ScrollArrowStyle:
+    case eIntID_ScrollSliderStyle:
+    case eIntID_TreeOpenDelay:
+    case eIntID_TreeCloseDelay:
+    case eIntID_TreeLazyScrollDelay:
+    case eIntID_TreeScrollDelay:
+    case eIntID_TreeScrollLinesMax:
+    case eIntID_TabFocusModel:
+      aResult = 0;
+      break;
+    case eIntID_DragThresholdX:
+    case eIntID_DragThresholdY:
+      aResult = 8;
+      break;
+    case eIntID_UseOverlayScrollbars:
+      aResult = 1;
+      break;
+    case eIntID_ScrollbarDisplayOnMouseMove:
+    case eIntID_AllowOverlayScrollbarsOverlap:
+      aResult = 1;
+      break;
+    case eIntID_ScrollbarFadeBeginDelay:
+      aResult = 450;
+      break;
+    case eIntID_ScrollbarFadeDuration:
+      aResult = 200;
+      break;
+    case eIntID_TouchEnabled:
+      aResult = 1;
+      break;
+    case eIntID_SpellCheckerUnderlineStyle:
+      aResult = NS_STYLE_TEXT_DECORATION_STYLE_WAVY;
+      break;
+    case eIntID_IMERawInputUnderlineStyle:
+    case eIntID_IMEConvertedTextUnderlineStyle:
+      aResult = NS_STYLE_TEXT_DECORATION_STYLE_SOLID;
+      break;
+    case eIntID_IMESelectedRawTextUnderlineStyle:
+    case eIntID_IMESelectedConvertedTextUnderline:
+      aResult = NS_STYLE_TEXT_DECORATION_STYLE_NONE;
+      break;
+    default:
+      aResult = 0;
+      rv = NS_ERROR_FAILURE;
+      break;
+  }
+  return rv;
+}
+
+nsresult
+nsLookAndFeel::GetFloatImpl(FloatID aID, float& aResult)
+{
+  nsresult rv = nsXPLookAndFeel::GetFloatImpl(aID, aResult);
+  if (NS_SUCCEEDED(rv)) {
+    return rv;
+  }
+  switch (aID) {
+    case eFloatID_IMEUnderlineRelativeSize:
+      aResult = 1.0f;
+      return NS_OK;
+    case eFloatID_SpellCheckerUnderlineRelativeSize:
+      aResult = 1.0f;
+      return NS_OK;
+    default:
+      aResult = -1.0f;
+      return NS_ERROR_FAILURE;
+  }
+}
+
+bool
+nsLookAndFeel::GetFontImpl(FontID aID, nsString& aFontName, gfxFontStyle& aFontStyle,
+                           float aDevPixPerCSSPixel)
+{
+  // Windows Phone's UI font
+  aFontName.AssignLiteral("Segoe WP");
+  aFontStyle.style = NS_FONT_STYLE_NORMAL;
+  aFontStyle.weight = NS_FONT_WEIGHT_NORMAL;
+  aFontStyle.stretch = NS_FONT_STRETCH_NORMAL;
+  aFontStyle.size = 15.0f * aDevPixPerCSSPixel;
+  aFontStyle.systemFont = true;
+  return true;
+}
