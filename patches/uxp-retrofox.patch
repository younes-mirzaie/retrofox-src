+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef mozilla_widget_RetrofoxFrame_h
+#define mozilla_widget_RetrofoxFrame_h
+
+#include <stdint.h>
+
+namespace mozilla {
+namespace widget {
+
+// The latest frame painted by the phone's top-level window (widget/retrofox), for the process
+// that shows it (screenshot tool, or the phone app over shared memory).
+struct RetrofoxFrame
+{
+  const uint8_t* mData;   // B8G8R8A8 (premultiplied), top-down
+  int32_t mWidth;
+  int32_t mHeight;
+  int32_t mStride;        // bytes per row
+  uint32_t mSerial;       // increments with every paint
+};
+
+// Main thread only. Returns false until something has been painted. mData stays valid until the
+// next paint or until the window is destroyed.
+bool GetRetrofoxFrame(RetrofoxFrame* aOut);
+
+// Paints the top-level window now if it's dirty (main thread). Returns true if it painted.
+bool PaintRetrofoxFrameNow();
+
+} // namespace widget
+} // namespace mozilla
+
+#endif
