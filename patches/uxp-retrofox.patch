diff --git a/widget/retrofox/nsWindow.cpp b/widget/retrofox/nsWindow.cpp
new file mode 100644
index 000000000..5181b0feb
--- /dev/null
+++ b/widget/retrofox/nsWindow.cpp
@@ -0,0 +1,361 @@
+/* -*- Mode: C++; tab-width: 2; indent-tabs-mode: nil; c-basic-offset: 2 -*- */
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "nsWindow.h"
+
+#include "gfxContext.h"
+#include "mozilla/BasicEvents.h"
+#include "mozilla/gfx/2D.h"
+#include "mozilla/layers/LayersTypes.h"
+#include "nsIWidgetListener.h"
+#include "nsScreenManager.h"
+#include "nsThreadUtils.h"
+#include "RetrofoxFrame.h"
+
+using namespace mozilla;
+using namespace mozilla::gfx;
+using namespace mozilla::layers;
+using namespace mozilla::widget;
+
+nsWindow* nsWindow::sTopLevel = nullptr;
+
+NS_IMPL_ISUPPORTS_INHERITED0(nsWindow, Inherited)
+
+nsWindow::nsWindow()
+  : mVisible(false)
+  , mDirty(false)
+  , mPaintPending(false)
+  , mFrameSerial(0)
+  , mParent(nullptr)
+{
+}
+
+nsWindow::~nsWindow()
+{
+  if (sTopLevel == this) {
+    sTopLevel = nullptr;
+  }
+}
+
+bool
+nsWindow::IsTopLevel()
+{
+  return mWindowType == eWindowType_toplevel ||
+         mWindowType == eWindowType_dialog ||
+         mWindowType == eWindowType_invisible;
+}
+
+nsWindow*
+nsWindow::FindTopLevel()
+{
+  nsWindow* w = this;
+  while (w->mParent) {
+    w = w->mParent;
+  }
+  return w;
+}
+
+nsresult
+nsWindow::Create(nsIWidget* aParent,
+                 nsNativeWidget aNativeParent,
+                 const LayoutDeviceIntRect& aRect,
+                 nsWidgetInitData* aInitData)
+{
+  nsWindow* parent = static_cast<nsWindow*>(aParent);
+
+  // Top-level windows always fill the phone screen
+  mBounds = parent ? aRect : RetrofoxScreenManager::GetBounds();
+
+  mWindowType = eWindowType_toplevel;
+  mBorderStyle = eBorderStyle_default;
+  Inherited::BaseCreate(aParent, aInitData);
+
+  if (parent) {
+    parent->mChildren.AppendElement(this);
+    mParent = parent;
+  }
+  return NS_OK;
+}
+
+void
+nsWindow::Destroy()
+{
+  for (uint32_t i = 0; i < mChildren.Length(); ++i) {
+    mChildren[i]->mParent = nullptr;
+  }
+  mChildren.Clear();
+  if (mParent) {
+    mParent->mChildren.RemoveElement(this);
+    mParent = nullptr;
+  }
+  if (sTopLevel == this) {
+    sTopLevel = nullptr;
+  }
+  mFrame = nullptr;
+
+  nsBaseWidget::Destroy();
+  nsBaseWidget::OnDestroy();
+}
+
+nsresult
+nsWindow::ConfigureChildren(const nsTArray<nsIWidget::Configuration>& aConfig)
+{
+  for (uint32_t i = 0; i < aConfig.Length(); ++i) {
+    nsWindow* child = static_cast<nsWindow*>(aConfig[i].mChild.get());
+    child->Resize(aConfig[i].mBounds.x, aConfig[i].mBounds.y,
+                  aConfig[i].mBounds.width, aConfig[i].mBounds.height, false);
+  }
+  return NS_OK;
+}
+
+NS_IMETHODIMP
+nsWindow::Show(bool aState)
+{
+  if (aState != mVisible) {
+    mVisible = aState;
+    if (aState) {
+      if (IsTopLevel() && !mParent) {
+        sTopLevel = this;
+      }
+      mDirty = true;
+      ScheduleTopLevelPaint();
+    }
+  }
+  return NS_OK;
+}
+
+NS_IMETHODIMP
+nsWindow::Move(double aX, double aY)
+{
+  if (mBounds.x == aX && mBounds.y == aY) {
+    return NS_OK;
+  }
+  mBounds.x = aX;
+  mBounds.y = aY;
+  ReportMoveEvent();
+  return NS_OK;
+}
+
+NS_IMETHODIMP
+nsWindow::Resize(double aX, double aY, double aWidth, double aHeight, bool aRepaint)
+{
+  bool moving = mBounds.x != aX || mBounds.y != aY;
+  bool resizing = mBounds.width != aWidth || mBounds.height != aHeight;
+  if (!moving && !resizing) {
+    return NS_OK;
+  }
+  mBounds.x = aX;
+  mBounds.y = aY;
+  mBounds.width = aWidth;
+  mBounds.height = aHeight;
+  if (moving) {
+    ReportMoveEvent();
+  }
+  if (resizing) {
+    ReportSizeEvent();
+  }
+  if (aRepaint) {
+    Invalidate(mBounds);
+  }
+  return NS_OK;
+}
+
+NS_IMETHODIMP
+nsWindow::Resize(double aWidth, double aHeight, bool aRepaint)
+{
+  return Resize(mBounds.x, mBounds.y, aWidth, aHeight, aRepaint);
+}
+
+void
+nsWindow::SetSizeMode(nsSizeMode aMode)
+{
+  if (aMode == mSizeMode) {
+    return;
+  }
+  mSizeMode = aMode;
+  ReportSizeModeEvent(aMode);
+}
+
+double
+nsWindow::GetDefaultScaleInternal()
+{
+  return RetrofoxScreenManager::GetScale();
+}
+
+LayoutDeviceIntRect
+nsWindow::GetScreenBounds()
+{
+  return LayoutDeviceIntRect(WidgetToScreenOffset(), mBounds.Size());
+}
+
+LayoutDeviceIntPoint
+nsWindow::WidgetToScreenOffset()
+{
+  LayoutDeviceIntPoint offset(mBounds.x, mBounds.y);
+  if (mParent) {
+    offset += mParent->WidgetToScreenOffset();
+  }
+  return offset;
+}
+
+NS_IMETHODIMP
+nsWindow::Invalidate(const LayoutDeviceIntRect& aRect)
+{
+  nsWindow* top = FindTopLevel();
+  top->mDirty = true;
+  top->ScheduleTopLevelPaint();
+  return NS_OK;
+}
+
+void
+nsWindow::ScheduleTopLevelPaint()
+{
+  if (mPaintPending || !mVisible) {
+    return;
+  }
+  mPaintPending = true;
+  RefPtr<nsWindow> self = this;
+  NS_DispatchToMainThread(NS_NewRunnableFunction([self]() {
+    self->mPaintPending = false;
+    self->PaintIfDirty();
+  }));
+}
+
+bool
+nsWindow::PaintIfDirty()
+{
+  if (!mDirty || !mVisible || !mWidgetListener || mBounds.IsEmpty()) {
+    return false;
+  }
+  mDirty = false;
+
+  IntSize size(mBounds.width, mBounds.height);
+  if (!mFrame || mFrame->GetSize() != size) {
+    mFrame = Factory::CreateDrawTarget(BackendType::SKIA, size, SurfaceFormat::B8G8R8A8);
+    if (!mFrame) {
+      return false;
+    }
+  }
+
+  mWidgetListener->WillPaintWindow(this);
+  if (!mWidgetListener) {
+    return false;
+  }
+
+  bool painted = false;
+  {
+    RefPtr<gfxContext> ctx = gfxContext::CreateOrNull(mFrame);
+    if (!ctx) {
+      return false;
+    }
+    AutoLayerManagerSetup setup(this, ctx, BufferMode::BUFFER_NONE);
+    LayoutDeviceIntRegion region(LayoutDeviceIntRect(0, 0, mBounds.width, mBounds.height));
+    painted = mWidgetListener->PaintWindow(this, region);
+  }
+  mFrame->Flush();
+  if (mWidgetListener) {
+    mWidgetListener->DidPaintWindow();
+  }
+  ++mFrameSerial;
+  return painted;
+}
+
+void
+nsWindow::ReportMoveEvent()
+{
+  NotifyWindowMoved(mBounds.x, mBounds.y);
+}
+
+void
+nsWindow::ReportSizeModeEvent(nsSizeMode aMode)
+{
+  if (mWidgetListener) {
+    mWidgetListener->SizeModeChanged(aMode);
+  }
+}
+
+void
+nsWindow::ReportSizeEvent()
+{
+  if (mWidgetListener) {
+    LayoutDeviceIntRect inner = GetClientBounds();
+    mWidgetListener->WindowResized(this, inner.width, inner.height);
+  }
+}
+
+NS_IMETHODIMP
+nsWindow::DispatchEvent(WidgetGUIEvent* aEvent, nsEventStatus& aStatus)
+{
+  aStatus = nsEventStatus_eIgnore;
+  nsCOMPtr<nsIWidget> kungFuDeathGrip(aEvent->mWidget);
+  if (mWidgetListener) {
+    aStatus = mWidgetListener->HandleEvent(aEvent, mUseAttachedEvents);
+  }
+  return NS_OK;
+}
+
+NS_IMETHODIMP_(void)
+nsWindow::SetInputContext(const InputContext& aContext, const InputContextAction& aAction)
+{
+  // TODO: ask the phone app to show the software keyboard
+  mInputContext = aContext;
+}
+
+NS_IMETHODIMP_(InputContext)
+nsWindow::GetInputContext()
+{
+  return mInputContext;
+}
+
+void*
+nsWindow::GetNativeData(uint32_t aDataType)
+{
+  switch (aDataType) {
+    case NS_RAW_NATIVE_IME_CONTEXT: {
+      void* ctx = GetPseudoIMEContext();
+      return ctx ? ctx : NS_ONLY_ONE_NATIVE_IME_CONTEXT;
+    }
+    default:
+      // There is no native window, display or graphics context
+      return nullptr;
+  }
+}
+
+namespace mozilla {
+namespace widget {
+
+bool
+GetRetrofoxFrame(RetrofoxFrame* aOut)
+{
+  nsWindow* top = nsWindow::TopLevel();
+  if (!top || !top->FrameTarget()) {
+    return false;
+  }
+  uint8_t* data = nullptr;
+  IntSize size;
+  int32_t stride = 0;
+  SurfaceFormat format;
+  if (!top->FrameTarget()->LockBits(&data, &size, &stride, &format)) {
+    return false;
+  }
+  // Skia keeps the pixels in place; unlock right away and hand out the pointer
+  top->FrameTarget()->ReleaseBits(data);
+  aOut->mData = data;
+  aOut->mWidth = size.width;
+  aOut->mHeight = size.height;
+  aOut->mStride = stride;
+  aOut->mSerial = top->FrameSerial();
+  return true;
+}
+
+bool
+PaintRetrofoxFrameNow()
+{
+  nsWindow* top = nsWindow::TopLevel();
+  return top && top->PaintIfDirty();
+}
+
+} // namespace widget
+} // namespace mozilla
diff --git a/widget/retrofox/nsWindow.h b/widget/retrofox/nsWindow.h
