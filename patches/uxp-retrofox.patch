diff --git a/widget/retrofox/nsAppShell.cpp b/widget/retrofox/nsAppShell.cpp
new file mode 100644
index 000000000..d8da7e935
--- /dev/null
+++ b/widget/retrofox/nsAppShell.cpp
@@ -0,0 +1,47 @@
+/* -*- Mode: C++; tab-width: 2; indent-tabs-mode: nil; c-basic-offset: 2 -*- */
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "nsAppShell.h"
+
+nsAppShell::nsAppShell()
+  : mWakeEvent(nullptr)
+{
+}
+
+nsAppShell::~nsAppShell()
+{
+  if (mWakeEvent) {
+    CloseHandle(mWakeEvent);
+  }
+}
+
+nsresult
+nsAppShell::Init()
+{
+  // Auto-reset: one wake per ScheduleNativeEventCallback
+  mWakeEvent = CreateEventW(nullptr, FALSE, FALSE, nullptr);
+  if (!mWakeEvent) {
+    return NS_ERROR_FAILURE;
+  }
+  return nsBaseAppShell::Init();
+}
+
+void
+nsAppShell::ScheduleNativeEventCallback()
+{
+  // Called from any thread; NativeEventCallback() runs on the main thread when it wakes
+  SetEvent(mWakeEvent);
+}
+
+bool
+nsAppShell::ProcessNextNativeEvent(bool aMayWait)
+{
+  DWORD rv = WaitForSingleObject(mWakeEvent, aMayWait ? INFINITE : 0);
+  if (rv == WAIT_OBJECT_0) {
+    NativeEventCallback();
+    return true;
+  }
+  return false;
+}
