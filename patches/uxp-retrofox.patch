+
+#include "nsScreenManager.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+
+using namespace mozilla;
+
+static LayoutDeviceIntRect gScreenBounds;
+static double gScreenScale = 1.5;
+static bool gScreenInited = false;
+
+static void
+InitScreen()
+{
+  if (gScreenInited) {
+    return;
+  }
+  gScreenInited = true;
+  // Lumia: 480x800 at 1.5 CSS scale (320x533 CSS px, like other 4.3" phones)
+  int w = 480, h = 800;
+  double scale = 1.5;
+  if (const char* env = getenv("RETROFOX_SCREEN")) {
+    sscanf(env, "%d,%d,%lf", &w, &h, &scale);
+  }
+  gScreenBounds = LayoutDeviceIntRect(0, 0, w, h);
+  gScreenScale = scale > 0 ? scale : 1.0;
+}
+
+LayoutDeviceIntRect
+RetrofoxScreenManager::GetBounds()
+{
+  InitScreen();
+  return gScreenBounds;
+}
+
+double
+RetrofoxScreenManager::GetScale()
+{
+  InitScreen();
+  return gScreenScale;
+}
+
+NS_IMETHODIMP
+RetrofoxScreen::GetRect(int32_t* aLeft, int32_t* aTop, int32_t* aWidth, int32_t* aHeight)
+{
+  LayoutDeviceIntRect r = RetrofoxScreenManager::GetBounds();
+  *aLeft = r.x;
+  *aTop = r.y;
+  *aWidth = r.width;
+  *aHeight = r.height;
+  return NS_OK;
+}
+
+NS_IMETHODIMP
+RetrofoxScreen::GetAvailRect(int32_t* aLeft, int32_t* aTop, int32_t* aWidth, int32_t* aHeight)
+{
+  return GetRect(aLeft, aTop, aWidth, aHeight);
+}
+
+NS_IMETHODIMP
+RetrofoxScreen::GetPixelDepth(int32_t* aPixelDepth)
+{
+  *aPixelDepth = 24;
+  return NS_OK;
+}
+
+NS_IMETHODIMP
+RetrofoxScreen::GetColorDepth(int32_t* aColorDepth)
+{
+  return GetPixelDepth(aColorDepth);
+}
+
+NS_IMETHODIMP
+RetrofoxScreen::GetContentsScaleFactor(double* aContentsScaleFactor)
+{
+  *aContentsScaleFactor = 1.0;
+  return NS_OK;
+}
+
+NS_IMETHODIMP
+RetrofoxScreen::GetDefaultCSSScaleFactor(double* aScaleFactor)
+{
+  *aScaleFactor = RetrofoxScreenManager::GetScale();
+  return NS_OK;
+}
+
+NS_IMPL_ISUPPORTS(RetrofoxScreenManager, nsIScreenManager)
+
+RetrofoxScreenManager::RetrofoxScreenManager()
+  : mScreen(new RetrofoxScreen())
+{
+}
+
+NS_IMETHODIMP
+RetrofoxScreenManager::GetPrimaryScreen(nsIScreen** aOutScreen)
+{
+  NS_IF_ADDREF(*aOutScreen = mScreen.get());
+  return NS_OK;
+}
+
+NS_IMETHODIMP
+RetrofoxScreenManager::ScreenForRect(int32_t aLeft, int32_t aTop, int32_t aWidth, int32_t aHeight,
+                                     nsIScreen** aOutScreen)
+{
+  return GetPrimaryScreen(aOutScreen);
+}
+
+NS_IMETHODIMP
+RetrofoxScreenManager::ScreenForId(uint32_t aId, nsIScreen** aOutScreen)
+{
+  return GetPrimaryScreen(aOutScreen);
+}
+
+NS_IMETHODIMP
+RetrofoxScreenManager::ScreenForNativeWidget(void* aWidget, nsIScreen** aOutScreen)
+{
+  return GetPrimaryScreen(aOutScreen);
+}
+
+NS_IMETHODIMP
+RetrofoxScreenManager::GetNumberOfScreens(uint32_t* aNumberOfScreens)
+{
+  *aNumberOfScreens = 1;
+  return NS_OK;
+}
+
+NS_IMETHODIMP
+RetrofoxScreenManager::GetSystemDefaultScale(float* aScale)
+{
+  *aScale = 1.0f;
+  return NS_OK;
+}
