+void DispatchRetrofoxText(const char16_t* aText, uint32_t aLength);
+
+// Called (main thread) when a text field gains or loses focus, so the app can show or hide the
+// software keyboard.
+typedef void (*RetrofoxTextFocusCallback)(bool aFocused);
