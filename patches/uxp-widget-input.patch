+static LayoutDeviceIntPoint sLastPointer(0, 0);
+
+static nsWindow*
+TargetAt(LayoutDeviceIntPoint& aPoint)
+{
+  nsWindow* top = nsWindow::TopLevel();
+  return top ? top->ChildAt(aPoint) : nullptr;
+}
+
+void
+DispatchRetrofoxPointer(RetrofoxPointerAction aAction, int32_t aX, int32_t aY)
+{
+  sLastPointer = LayoutDeviceIntPoint(aX, aY);
+  LayoutDeviceIntPoint pt(aX, aY);
+  RefPtr<nsWindow> target = TargetAt(pt);
+  if (!target) {
+    return;
+  }
+  // A tap is move + down + up, like widget/uikit
+  EventMessage messages[2] = { eMouseMove, eVoidEvent };
+  if (aAction == eRetrofoxPointerDown) {
+    messages[1] = eMouseDown;
+  } else if (aAction == eRetrofoxPointerUp) {
+    messages[0] = eMouseUp;
+  }
+  for (EventMessage msg : messages) {
+    if (msg == eVoidEvent) {
+      continue;
+    }
+    WidgetMouseEvent event(true, msg, target, WidgetMouseEvent::eReal, WidgetMouseEvent::eNormal);
+    event.mRefPoint = pt;
+    event.mClickCount = msg == eMouseMove ? 0 : 1;
+    event.button = WidgetMouseEvent::eLeftButton;
+    event.mTime = PR_IntervalNow();
+    event.inputSource = nsIDOMMouseEvent::MOZ_SOURCE_TOUCH;
+    nsEventStatus status;
+    target->DispatchEvent(&event, status);
+  }
+}
+
+void
+DispatchRetrofoxScroll(int32_t aDX, int32_t aDY)
+{
+  LayoutDeviceIntPoint pt = sLastPointer;
+  RefPtr<nsWindow> target = TargetAt(pt);
+  if (!target) {
+    return;
+  }
+  WidgetWheelEvent wheel(true, eWheel, target);
+  wheel.mRefPoint = pt;
+  wheel.mDeltaMode = nsIDOMWheelEvent::DOM_DELTA_PIXEL;
+  wheel.mDeltaX = aDX;
+  wheel.mDeltaY = aDY;
+  wheel.mIsNoLineOrPageDelta = true;
+  wheel.mScrollType = WidgetWheelEvent::SCROLL_SYNCHRONOUSLY;
+  wheel.mTime = PR_IntervalNow();
+  nsEventStatus status;
+  target->DispatchEvent(&wheel, status);
+}
+
+static void
+DispatchKeyEvent(nsWindow* aTarget, EventMessage aMessage, uint32_t aKeyCode, char16_t aChar)
+{
+  WidgetKeyboardEvent event(true, aMessage, aTarget);
+  event.mTime = PR_IntervalNow();
+  if (aChar) {
+    event.mKeyNameIndex = KEY_NAME_INDEX_USE_STRING;
+    event.mKeyValue.Assign(aChar);
+    if (aMessage == eKeyPress) {
+      event.mCharCode = aChar;
+    }
+  } else {
+    event.mKeyCode = aKeyCode;
+    event.mKeyNameIndex = aKeyCode == NS_VK_BACK ? KEY_NAME_INDEX_Backspace :
+                          aKeyCode == NS_VK_RETURN ? KEY_NAME_INDEX_Enter :
+                          KEY_NAME_INDEX_Unidentified;
+  }
+  nsEventStatus status;
+  aTarget->DispatchEvent(&event, status);
+}
+
+void
+DispatchRetrofoxKey(uint32_t aVirtualKey)
+{
+  // Keys go to the window under the last tap: that's where the focused field is
+  LayoutDeviceIntPoint pt = sLastPointer;
+  RefPtr<nsWindow> target = TargetAt(pt);
+  if (!target) {
+    return;
+  }
+  // Windows virtual-key codes match the DOM key codes for the keys the app sends
+  DispatchKeyEvent(target, eKeyDown, aVirtualKey, 0);
+  DispatchKeyEvent(target, eKeyPress, aVirtualKey, 0);
+  DispatchKeyEvent(target, eKeyUp, aVirtualKey, 0);
+}
+
+void
+DispatchRetrofoxText(const char16_t* aText, uint32_t aLength)
+{
+  LayoutDeviceIntPoint pt = sLastPointer;
+  RefPtr<nsWindow> target = TargetAt(pt);
+  if (!target) {
+    return;
+  }
+  for (uint32_t i = 0; i < aLength; ++i) {
+    DispatchKeyEvent(target, eKeyDown, 0, aText[i]);
+    DispatchKeyEvent(target, eKeyPress, 0, aText[i]);
+    DispatchKeyEvent(target, eKeyUp, 0, aText[i]);
+  }
+}
+
+void
+SetRetrofoxTextFocusCallback(RetrofoxTextFocusCallback aCallback)
+{
+  sTextFocusCallback = aCallback;
+}
+
 } // namespace widget
 } // namespace mozilla
