+void
+nsWindow::PaintTree(DrawTarget* aTarget, const LayoutDeviceIntPoint& aOffset, bool* aPainted)
+{
+  if (!mVisible) {
+    return;
+  }
+  if (mWidgetListener) {
+    mWidgetListener->WillPaintWindow(this);
+  }
+  if (mWidgetListener) {
+    RefPtr<gfxContext> ctx = gfxContext::CreateOrNull(aTarget);
+    if (ctx) {
+      ctx->SetMatrix(gfxMatrix::Translation(aOffset.x, aOffset.y));
+      AutoLayerManagerSetup setup(this, ctx, BufferMode::BUFFER_NONE);
+      LayoutDeviceIntRegion region(LayoutDeviceIntRect(0, 0, mBounds.width, mBounds.height));
+      if (mWidgetListener->PaintWindow(this, region)) {
+        *aPainted = true;
+      }
+    }
+    if (mWidgetListener) {
+      mWidgetListener->DidPaintWindow();
+    }
+  }
+  // Copy the list: painting can create or destroy windows
+  nsTArray<RefPtr<nsWindow>> children;
+  for (uint32_t i = 0; i < mChildren.Length(); ++i) {
+    children.AppendElement(mChildren[i]);
+  }
+  for (uint32_t i = 0; i < children.Length(); ++i) {
+    nsWindow* c = children[i];
+    c->PaintTree(aTarget, aOffset + LayoutDeviceIntPoint(c->mBounds.x, c->mBounds.y), aPainted);
+  }
+}
+
+nsWindow*
+nsWindow::ChildAt(LayoutDeviceIntPoint& aPoint)
+{
+  // Last child on top
+  for (int32_t i = int32_t(mChildren.Length()) - 1; i >= 0; --i) {
+    nsWindow* c = mChildren[i];
+    if (c->mVisible && c->mBounds.Contains(aPoint)) {
+      aPoint -= LayoutDeviceIntPoint(c->mBounds.x, c->mBounds.y);
+      return c->ChildAt(aPoint);
+    }
+  }
+  return this;
+}
