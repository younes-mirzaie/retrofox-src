+void
+nsStyleDisplay::UpdateCombinedTransform()
+{
+  if (!mSpecifiedTranslate && !mSpecifiedRotate && !mSpecifiedScale) {
+    mCombinedTransform = mSpecifiedTransform;
+    return;
+  }
+  nsCSSValueList* head = nullptr;
+  nsCSSValueList** tail = &head;
+  const nsCSSValueSharedList* lists[] = { mSpecifiedTranslate, mSpecifiedRotate,
+                                          mSpecifiedScale, mSpecifiedTransform };
+  for (const nsCSSValueSharedList* list : lists) {
+    for (const nsCSSValueList* item = list ? list->mHead : nullptr; item; item = item->mNext) {
+      nsCSSValueList* copy = new nsCSSValueList;
+      copy->mValue = item->mValue;
+      *tail = copy;
+      tail = &copy->mNext;
+    }
+  }
+  mCombinedTransform = new nsCSSValueSharedList(head);
+}
