+/* The individual transform properties (CSS Transforms 2), stored as a one-function transform
+ * list so they compute, animate and apply like transform:
+ *   translate: none | <length-percentage> [ <length-percentage> <length>? ]?   -> translate3d()
+ *   scale:     none | [ <number> | <percentage> ]{1,3}                          -> scale3d()
+ *   rotate:    none | <angle> | [ x | y | z | <number>{3} ] && <angle>          -> rotate()/rotate3d()
+ */
+bool
+CSSParserImpl::ParseIndividualTransform(nsCSSPropertyID aPropID)
+{
+  nsCSSValue value;
+  if (ParseSingleTokenVariant(value, VARIANT_INHERIT | VARIANT_NONE, nullptr)) {
+    AppendValue(aPropID, value);
+    return true;
+  }
+
+  nsCSSValue func;
+  if (aPropID == eCSSProperty_translate) {
+    nsCSSValue v[3];
+    if (ParseVariant(v[0], VARIANT_LPCALC, nullptr) != CSSParseResult::Ok) {
+      return false;
+    }
+    CSSParseResult r = ParseVariant(v[1], VARIANT_LPCALC, nullptr);
+    if (r == CSSParseResult::Error) {
+      return false;
+    }
+    if (r == CSSParseResult::Ok &&
+        ParseVariant(v[2], VARIANT_LCALC, nullptr) == CSSParseResult::Error) {
+      return false;
+    }
+    for (nsCSSValue& c : v) {
+      if (c.GetUnit() == eCSSUnit_Null) {
+        c.SetFloatValue(0.0f, eCSSUnit_Pixel);
+      }
+    }
+    RefPtr<nsCSSValue::Array> a = func.InitFunction(eCSSKeyword_translate3d, 3);
+    for (int i = 0; i < 3; ++i) {
+      a->Item(i + 1) = v[i];
+    }
+  } else if (aPropID == eCSSProperty_scale) {
+    float s[3];
+    int n = 0;
+    for (; n < 3; ++n) {
+      nsCSSValue c;
+      CSSParseResult r = ParseVariant(c, VARIANT_NUMBER | VARIANT_PERCENT, nullptr);
+      if (r == CSSParseResult::Error) {
+        return false;
+      }
+      if (r == CSSParseResult::NotFound) {
+        break;
+      }
+      s[n] = c.GetUnit() == eCSSUnit_Percent ? c.GetPercentValue() : c.GetFloatValue();
+    }
+    if (n == 0) {
+      return false;
+    }
+    if (n == 1) {
+      s[1] = s[0];
+    }
+    if (n < 3) {
+      s[2] = 1.0f;
+    }
+    RefPtr<nsCSSValue::Array> a = func.InitFunction(eCSSKeyword_scale3d, 3);
+    for (int i = 0; i < 3; ++i) {
+      a->Item(i + 1).SetFloatValue(s[i], eCSSUnit_Number);
+    }
+  } else {
+    // rotate: the angle and the axis, in either order
+    nsCSSValue angle;
+    float axis[3] = { 0, 0, 1 };
+    bool haveAxis = false;
+    for (int part = 0; part < 2; ++part) {
+      if (angle.GetUnit() == eCSSUnit_Null) {
+        CSSParseResult r = ParseVariant(angle, VARIANT_ANGLE | VARIANT_ZERO_ANGLE, nullptr);
+        if (r == CSSParseResult::Error) {
+          return false;
+        }
+        if (r == CSSParseResult::Ok) {
+          continue;
+        }
+      }
+      if (haveAxis || !GetToken(true)) {
+        break;
+      }
+      if (mToken.mType == eCSSToken_Ident &&
+          (mToken.mIdent.LowerCaseEqualsLiteral("x") ||
+           mToken.mIdent.LowerCaseEqualsLiteral("y") ||
+           mToken.mIdent.LowerCaseEqualsLiteral("z"))) {
+        char16_t c = ToLowerCase(mToken.mIdent[0]);
+        axis[0] = c == 'x';
+        axis[1] = c == 'y';
+        axis[2] = c == 'z';
+        haveAxis = true;
+        continue;
+      }
+      UngetToken();
+      for (int i = 0; i < 3; ++i) {
+        nsCSSValue c;
+        if (ParseVariant(c, VARIANT_NUMBER, nullptr) != CSSParseResult::Ok) {
+          return false;
+        }
+        axis[i] = c.GetFloatValue();
+      }
+      haveAxis = true;
+    }
+    if (angle.GetUnit() == eCSSUnit_Null) {
+      return false;
+    }
+    if (!haveAxis || (axis[0] == 0 && axis[1] == 0)) {
+      RefPtr<nsCSSValue::Array> a = func.InitFunction(eCSSKeyword_rotate, 1);
+      a->Item(1) = angle;
+    } else {
+      RefPtr<nsCSSValue::Array> a = func.InitFunction(eCSSKeyword_rotate3d, 4);
+      for (int i = 0; i < 3; ++i) {
+        a->Item(i + 1).SetFloatValue(axis[i], eCSSUnit_Number);
+      }
+      a->Item(4) = angle;
+    }
+  }
+
+  if (!CheckEndProperty()) {
+    return false;
+  }
+  nsCSSValueSharedList* list = new nsCSSValueSharedList;
+  value.SetSharedListValue(list);
+  list->mHead = new nsCSSValueList;
+  list->mHead->mValue = func;
+  AppendValue(aPropID, value);
+  return true;
+}
