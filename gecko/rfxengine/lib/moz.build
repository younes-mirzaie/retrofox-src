# The engine itself, built into libxul: it uses Gecko's internal API (the widget/retrofox
# frame, preferences, internal strings), which xul.dll doesn't export to programs.
# rfxengine.exe (..) calls RetrofoxEngineMain.

SOURCES += [
    'rfxengine.cpp',
    'rfxview.cpp',
]

LOCAL_INCLUDES += [
    '/layout/generic',
    '/widget/retrofox',
]

FINAL_LIBRARY = 'xul'
